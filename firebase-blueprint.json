{
  "entities": {
    "VendorProfile": {
      "title": "Vendor Profile",
      "description": "Vendor configuration, business profile, UPI payment info, and reminder templates.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessName": { "type": "string" },
        "upiId": { "type": "string" },
        "payeeName": { "type": "string" },
        "phone": { "type": "string" },
        "reminderTemplate": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "businessName", "upiId", "payeeName"]
    },
    "Invoice": {
      "title": "Invoice Receivable",
      "description": "Invoice item imported from Tally/Excel or created manually.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vendorId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "invoiceDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "amount": { "type": "number" },
        "balance": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "partially_paid", "paid", "overdue"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "vendorId", "customerName", "customerPhone", "invoiceNumber", "amount", "balance", "status"]
    },
    "ReminderLog": {
      "title": "Reminder Log",
      "description": "Log of WhatsApp payment reminders sent to customers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceId": { "type": "string" },
        "vendorId": { "type": "string" },
        "customerPhone": { "type": "string" },
        "channel": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "invoiceId", "vendorId", "customerPhone", "timestamp"]
    }
  },
  "firestore": {
    "/vendor_profiles/{userId}": {
      "schema": "VendorProfile",
      "description": "Collection of vendor profile settings keyed by User Auth UID."
    },
    "/vendors/{vendorId}": {
      "schema": "VendorProfile",
      "description": "Collection of store and vendor configs."
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Collection of business invoices and receivables."
    },
    "/reminder_logs/{logId}": {
      "schema": "ReminderLog",
      "description": "Collection of communication logs."
    },
    "/stores/{storeId}": {
      "schema": "object",
      "description": "Public storefront profiles."
    },
    "/products/{productId}": {
      "schema": "object",
      "description": "Catalog products for storefronts."
    },
    "/orders/{orderId}": {
      "schema": "object",
      "description": "Customer orders and checkout records."
    }
  }
}
