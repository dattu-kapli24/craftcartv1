{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/(?!products|assets|static|favicon|admin|login|index).*$",
      "destination": "/index.html"
    }
  ]
}
