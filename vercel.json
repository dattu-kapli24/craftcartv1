{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/orderspot-collect/:path*", "destination": "/collect.html" },
    { "source": "/orderspot-collect", "destination": "/collect.html" },
    { "source": "/collect/:path*", "destination": "/collect.html" },
    { "source": "/collect", "destination": "/collect.html" },
    { "source": "/admin/:path*", "destination": "/admin.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/store", "destination": "/store.html" },
    { "source": "/pay", "destination": "/pay.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
